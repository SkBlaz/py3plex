ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

# Set metadata
LABEL maintainer="Py3plex GUI"
LABEL description="FastAPI backend for Py3plex GUI"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    git \
    curl \
    graphviz \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    celery==5.3.4 \
    redis==5.0.1 \
    python-multipart==0.0.6 \
    pydantic==2.5.3 \
    pydantic-settings==2.1.0 \
    networkx==3.2.1 \
    matplotlib==3.8.2 \
    numpy==1.26.3 \
    scipy==1.11.4 \
    scikit-learn==1.4.0 \
    python-louvain==0.16 \
    aiofiles==23.2.1 \
    pytest>=7.0 \
    pytest-asyncio>=0.21.0 \
    pytest-timeout>=2.2.0 \
    httpx>=0.25.0

# Set working directory
WORKDIR /app

# Copy application code
COPY ./api/app ./app
COPY ./ci/api-tests ./ci/api-tests
COPY ./api/pytest.ini ./pytest.ini

# Install py3plex from mounted workspace
ARG PY3PLEX_PATH=/workspace
RUN pip install -e ${PY3PLEX_PATH}

# Create data directory
RUN mkdir -p /data/uploads /data/artifacts /data/workspaces

# Expose port
EXPOSE 8000

# Default command (can be overridden in docker-compose)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
