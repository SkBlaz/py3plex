{
  "name": "Multi-File Network Comparison",
  "description": "Load and compare networks from files",
  "datasets": [
    {
      "name": "network_from_file",
      "type": "file",
      "path": "sample_network.graphml"
    },
    {
      "name": "generated_for_comparison",
      "type": "generate",
      "generator": "random",
      "parameters": {
        "nodes": 20,
        "layers": 2,
        "probability": 0.3,
        "seed": 99
      }
    }
  ],
  "operations": [
    {
      "type": "stats",
      "dataset": "network_from_file",
      "parameters": {}
    },
    {
      "type": "stats",
      "dataset": "generated_for_comparison",
      "parameters": {}
    },
    {
      "type": "community",
      "dataset": "network_from_file",
      "parameters": {
        "algorithm": "louvain"
      }
    },
    {
      "type": "community",
      "dataset": "generated_for_comparison",
      "parameters": {
        "algorithm": "louvain"
      }
    },
    {
      "type": "visualize",
      "dataset": "network_from_file",
      "parameters": {
        "output": "file_network_viz.png",
        "layout": "spring"
      }
    },
    {
      "type": "visualize",
      "dataset": "generated_for_comparison",
      "parameters": {
        "output": "generated_network_viz.png",
        "layout": "spring"
      }
    }
  ],
  "output": {
    "directory": "file_comparison_results",
    "summary": "file_comparison_summary.json"
  }
}
