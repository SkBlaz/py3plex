# Optional CI workflow for fuzzing py3plex
#
# This workflow runs fuzzing campaigns to discover bugs in input parsing
# and network construction. It's designed to run on-demand or on a schedule
# rather than on every push/PR.
#
# To enable:
# 1. Uncomment the 'on' triggers below
# 2. Adjust fuzzing duration as needed
# 3. Commit and push

name: Fuzzing

# Uncomment to enable - currently disabled by default
# on:
#   workflow_dispatch:  # Manual trigger
#   schedule:
#     - cron: '0 2 * * 0'  # Weekly on Sunday at 2 AM UTC
#   push:
#     branches:
#       - main
#       - develop
#     paths:
#       - 'py3plex/core/parsers.py'
#       - 'py3plex/core/multinet.py'
#       - 'fuzzing/**'

jobs:
  fuzz-atheris:
    name: Atheris Fuzzing
    runs-on: ubuntu-latest
    timeout-minutes: 15  # Adjust based on fuzzing duration
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: |
          pip install --upgrade pip
          pip install -e .
          pip install atheris hypothesis
      
      - name: Run fuzzing campaign (5 minutes)
        run: |
          # Run fuzzing for 5 minutes
          bash fuzzing/run_fuzzing.sh 300
        continue-on-error: true  # Don't fail the workflow on expected errors
      
      - name: Check for crashes
        id: check_crashes
        run: |
          if ls fuzzing/crashes/crash-* 1>/dev/null 2>&1; then
            echo "crashes_found=true" >> $GITHUB_OUTPUT
            echo "⚠️ Crashes found during fuzzing!"
          else
            echo "crashes_found=false" >> $GITHUB_OUTPUT
            echo "✅ No crashes found"
          fi
      
      - name: Upload crash artifacts
        if: steps.check_crashes.outputs.crashes_found == 'true'
        uses: actions/upload-artifact@v3
        with:
          name: fuzzing-crashes
          path: |
            fuzzing/crashes/
            fuzzing/*.log
          retention-days: 30
      
      - name: Comment on PR (if crashes found)
        if: steps.check_crashes.outputs.crashes_found == 'true' && github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: '⚠️ **Fuzzing found potential crashes!**\n\nPlease review the crash artifacts in the workflow run.'
            })
      
      - name: Fail if crashes found
        if: steps.check_crashes.outputs.crashes_found == 'true'
        run: |
          echo "::error::Fuzzing discovered crashes. Please investigate the uploaded artifacts."
          exit 1

  fuzz-hypothesis:
    name: Hypothesis Property Tests
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: |
          pip install --upgrade pip
          pip install -e .
          pip install pytest hypothesis
      
      - name: Run property-based tests
        run: |
          pytest tests/test_fuzzing_properties.py -v --tb=short
      
      - name: Upload test results
        if: failure()
        uses: actions/upload-artifact@v3
        with:
          name: hypothesis-failures
          path: .hypothesis/
          retention-days: 30

  fuzz-docker-asan:
    name: Docker ASAN Fuzzing
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # Only run on main/develop to save CI resources
    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop'
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      - name: Build fuzzing container
        run: |
          docker build -t py3plex-fuzzing -f fuzzing/Dockerfile .
      
      - name: Run ASAN-enabled fuzzing
        run: |
          docker run --name fuzzing py3plex-fuzzing
        continue-on-error: true
      
      - name: Extract crash artifacts
        if: always()
        run: |
          docker cp fuzzing:/src/py3plex/fuzzing/crashes ./fuzzing-crashes-asan || true
          docker cp fuzzing:/src/py3plex/fuzzing/*.log ./fuzzing-logs-asan || true
      
      - name: Check for crashes
        id: check_asan_crashes
        run: |
          if ls fuzzing-crashes-asan/crash-* 1>/dev/null 2>&1; then
            echo "crashes_found=true" >> $GITHUB_OUTPUT
            echo "⚠️ ASAN detected crashes!"
          else
            echo "crashes_found=false" >> $GITHUB_OUTPUT
            echo "✅ No ASAN crashes found"
          fi
      
      - name: Upload ASAN crash artifacts
        if: steps.check_asan_crashes.outputs.crashes_found == 'true'
        uses: actions/upload-artifact@v3
        with:
          name: asan-fuzzing-crashes
          path: |
            fuzzing-crashes-asan/
            fuzzing-logs-asan/
          retention-days: 30
      
      - name: Clean up Docker
        if: always()
        run: |
          docker rm fuzzing || true
